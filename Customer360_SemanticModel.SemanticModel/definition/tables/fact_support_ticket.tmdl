table fact_support_ticket
	lineageTag: 1f606d44-67de-4496-9ae6-723418ca700e
	sourceLineageTag: [dbo].[fact_support_ticket]

	measure 'Total Tickets' =
			
			DISTINCTCOUNT(
			    fact_support_ticket[ticket_id]
			)
		formatString: 0
		lineageTag: 4edf3fd7-9661-469d-b47e-7c4086f3b84f

		changedProperty = Name

	measure 'Open Tickets' =
			
			CALCULATE(
			    [Total Tickets],
			    fact_support_ticket[is_open_ticket] = TRUE()
			)
		formatString: 0
		lineageTag: 2bb7c268-341f-4492-ab8d-f5bcc2f741f8

		changedProperty = Name

	measure 'Closed Tickets' =
			
			CALCULATE(
			    [Total Tickets],
			    fact_support_ticket[is_open_ticket] = FALSE()
			)
		formatString: 0
		lineageTag: d5c24d7d-a5c7-495c-99b2-7208cfa01d98

		changedProperty = Name

	measure 'Open Ticket %' =
			
			DIVIDE(
			    [Open Tickets],
			    [Total Tickets],
			    0
			)
		lineageTag: 22001a9b-537a-4a3f-91d6-88113eb18f2a

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'SLA Breaches' =
			
			CALCULATE(
			    [Total Tickets],
			    fact_support_ticket[sla_breached_flag] = TRUE()
			)
		formatString: 0
		lineageTag: 1eecbd91-9db9-4edc-b899-ae37c8fe20b0

		changedProperty = Name

	measure 'SLA Compliant Tickets' =
			
			[Total Tickets] - [SLA Breaches]
		formatString: 0
		lineageTag: cd37f029-247b-41da-9ecf-ede5573b1069

		changedProperty = Name

