table fact_account_snapshot
	lineageTag: 9dd6bc09-6ece-4b57-8beb-0bbb6c8c0523
	sourceLineageTag: [dbo].[fact_account_snapshot]

	measure 'Latest Snapshot Date' =
			
			MAX(
			    dim_date[date_value]
			)
		formatString: General Date
		lineageTag: 61029d8b-2bcb-4166-8128-0404e0211bb1

		changedProperty = Name

	measure 'Latest Snapshot Balance' =
			
			VAR LatestDate =
			    CALCULATE(
			        MAX(fact_account_snapshot[snapshot_date_key]),
			        ALL(fact_account_snapshot)
			    )
			RETURN
			    CALCULATE(
			        [Total Balance],
			        fact_account_snapshot[snapshot_date_key] = LatestDate
			    )
		lineageTag: 5e48a346-4de1-4a03-a852-51190db72768

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Previous Snapshot Balance' =
			
			VAR LatestDateKey =
			    CALCULATE(
			        MAX(fact_account_snapshot[snapshot_date_key]),
			        ALL(fact_account_snapshot)
			    )
			VAR PreviousDateKey =
			    CALCULATE(
			        MAX(fact_account_snapshot[snapshot_date_key]),
			        FILTER(
			            ALL(fact_account_snapshot[snapshot_date_key]),
			            fact_account_snapshot[snapshot_date_key] < LatestDateKey
			        )
			    )
			RETURN
			    CALCULATE(
			        [Total Balance],
			        fact_account_snapshot[snapshot_date_key] = PreviousDateKey
			    )
		lineageTag: 3cafe6d5-a324-415b-a5f1-b4bfc7adfa69

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Balance Change' =
			
			[Latest Snapshot Balance] - [Previous Snapshot Balance]
		lineageTag: 6c9a6547-7b7b-489c-860d-2acc773cd90a

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

