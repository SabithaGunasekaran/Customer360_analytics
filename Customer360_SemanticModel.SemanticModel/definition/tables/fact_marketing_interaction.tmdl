table fact_marketing_interaction
	lineageTag: a973f7d1-5650-4f28-a840-51f2afbe871d
	sourceLineageTag: [dbo].[fact_marketing_interaction]

	measure 'Total Interactions' =
			
			COUNTROWS(
			    fact_marketing_interaction
			)
		formatString: 0
		lineageTag: 913272b3-c22a-4e64-b6e1-0c774cb6d2e8

		changedProperty = Name

	measure 'Total Responses' =
			
			CALCULATE(
			    [Total Interactions],
			    fact_marketing_interaction[responded_flag] = TRUE()
			)
		formatString: 0
		lineageTag: ccdf4437-de15-4d78-8bf1-c3360f9048a4

		changedProperty = Name

	measure 'Response Rate %' =
			
			DIVIDE(
			    [Total Responses],
			    [Total Interactions],
			    0
			)
		lineageTag: c5aab3ba-7bad-40a9-8b4e-af0be6f9c280

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

