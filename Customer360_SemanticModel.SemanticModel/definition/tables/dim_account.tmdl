table dim_account
	lineageTag: 73bf0d2c-d255-4639-894b-066a3ad124bb
	sourceLineageTag: [dbo].[dim_account]

	measure 'Total Accounts' =
			
			DISTINCTCOUNT(
			    dim_account[account_id]
			)
		formatString: 0
		lineageTag: d454f441-06b3-4474-b5f2-687a46efac31

		changedProperty = Name

	measure 'Active Accounts' =
			
			CALCULATE(
			    DISTINCTCOUNT(dim_account[account_id]),
			    dim_account[is_active_account] = TRUE()
			)
		formatString: 0
		lineageTag: d5719d9b-8843-4d12-8bb7-9bf0e23f187d

		changedProperty = Name

	measure 'Inactive Accounts' =
			
			CALCULATE(
			    DISTINCTCOUNT(dim_account[account_id]),
			    dim_account[is_active_account] = FALSE()
			)
		formatString: 0
		lineageTag: 2dda2a99-47d5-476f-beaf-5d98b2a86fdf

		changedProperty = Name

	measure 'Active Account %' =
			
			DIVIDE(
			    [Active Accounts],
			    [Total Accounts],
			    0
			)
		lineageTag: 87e90130-cd32-4a6f-bcb2-6d8b28c83f4a

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Balance' =
			
			SUM(
			    fact_account_snapshot[balance]
			)
		lineageTag: 84d893a3-d9d9-4345-9fd5-8c3bcba7211a

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

