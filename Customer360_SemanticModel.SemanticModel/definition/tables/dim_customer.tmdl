table dim_customer
	lineageTag: 54177a5b-02ab-48ce-9fb1-bceb0f0a7d20
	sourceLineageTag: [dbo].[dim_customer]

	measure 'Total Customers' =
			
			CALCULATE(
			    DISTINCTCOUNT(dim_customer[customer_id]),
			    dim_customer[is_current] = TRUE()
			)
		formatString: 0
		lineageTag: 9cdaae51-a72d-405d-9385-93959b7090a6

		changedProperty = Name

	measure 'Active Customers' =
			
			CALCULATE(
			    DISTINCTCOUNT(dim_customer[customer_id]),
			    dim_customer[is_current] = TRUE(),
			    dim_customer[is_active_customer] = TRUE()
			)
		formatString: 0
		lineageTag: deafe34c-48e6-4495-bfdc-56cb3148cafb

		changedProperty = Name

	measure 'Inactive Customers' =
			
			CALCULATE(
			    DISTINCTCOUNT(dim_customer[customer_id]),
			    dim_customer[is_current] = TRUE(),
			    dim_customer[is_active_customer] = FALSE()
			)
		formatString: 0
		lineageTag: bca535f1-bedf-4123-a38d-fa2da9990bc6

		changedProperty = Name

	measure 'Active Customer %' =
			
			DIVIDE(
			    [Active Customers],
			    [Total Customers],
			    0
			)
		lineageTag: 8809acf3-40b4-4445-b77c-acbe1818fd98

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Customer Age' =
			
			CALCULATE(
			    AVERAGE(dim_customer[age]),
			    dim_customer[is_current] = TRUE()
			)
		lineageTag: 194fd1cc-4b3a-4fef-bc77-54598a171e65

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Customer Tenure' =
			
			CALCULATE(
			    AVERAGE(dim_customer[customer_tenure_years]),
			    dim_customer[is_current] = TRUE()
			)
		formatString: "£"#,0.###############;-"£"#,0.###############;"£"#,0.###############
		lineageTag: 5375ad2c-aaff-4fa6-8d6c-8d30ae955001

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

