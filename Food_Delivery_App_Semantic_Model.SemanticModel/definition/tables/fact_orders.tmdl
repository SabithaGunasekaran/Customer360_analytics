table fact_orders
	lineageTag: 5b6de1a6-3b9c-4bd7-b2aa-5ba9bc651dc0
	sourceLineageTag: [dbo].[fact_orders]

	measure 'Total Orders' =
			
			DISTINCTCOUNT(fact_orders[order_id])
		formatString: 0
		lineageTag: 6dae2680-0ed0-42ec-98d8-51fdc5e5198c

		changedProperty = Name

	measure 'Total Revenue' =
			
			SUM(fact_orders[order_amount])
		formatString: "£"#,0.###############;-"£"#,0.###############;"£"#,0.###############
		lineageTag: 2632995d-1756-41ea-9339-294ef76a6bf1

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Average Order Value' =
			
			DIVIDE(
			    [Total Revenue],
			    [Total Orders],
			    0
			)
		formatString: "£"#,0.###############;-"£"#,0.###############;"£"#,0.###############
		lineageTag: 1e0a5f73-a7e1-47de-83f3-992601d9bc40

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

	measure 'Total Items' =
			
			SUM(fact_orders[quantity])
		formatString: 0
		lineageTag: db6ac391-8c4d-4b7e-97d1-0ca2772ac44f

		changedProperty = Name

	measure 'Completed Orders' =
			
			CALCULATE(
			    [Total Orders],
			    fact_orders[order_status] = "Completed"
			)
		formatString: 0
		lineageTag: 3495ee7e-e159-4694-865c-c125bbe3968f

		changedProperty = Name

	measure 'Cancelled Orders' =
			
			CALCULATE(
			    [Total Orders],
			    fact_orders[order_status] = "Cancelled"
			)
		formatString: 0
		lineageTag: 0f07579d-3eaa-49b7-a4b3-8c55cfc1361c

		changedProperty = Name

	measure 'Cancellation Rate %' =
			
			DIVIDE(
			    [Cancelled Orders],
			    [Total Orders],
			    0
			)
		lineageTag: c70c9384-8e15-4ec3-bc70-79b672a0f7fe

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Delivered Orders' =
			
			CALCULATE(
			    [Total Orders],
			    fact_orders[delivery_status] = "Delivered"
			)
		formatString: 0
		lineageTag: 735d95e7-75f1-4113-9355-908490e97ae0

		changedProperty = Name

	measure 'Average Delivery Time' =
			
			AVERAGE(fact_orders[delivery_minutes])
		lineageTag: 033da90c-15a9-48da-aa6f-b33d79ddc233

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Driver Rating' =
			
			AVERAGE(fact_orders[driver_rating])
		formatString: "£"#,0.###############;-"£"#,0.###############;"£"#,0.###############
		lineageTag: 20c41d7e-1c16-41f4-afb2-87fb2d0b8cd0

		changedProperty = Name

		annotation PBI_FormatHint = {"currencyCulture":"en-GB"}

