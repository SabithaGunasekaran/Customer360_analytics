table dim_customer
	lineageTag: 92b16fa9-be39-4dc9-a991-2db7728cf74b
	sourceLineageTag: [dbo].[dim_customer]

	measure 'Total Customers' =
			
			DISTINCTCOUNT(dim_customer[customer_id])
		formatString: 0
		lineageTag: 8378530d-8482-4b37-b50f-c4041e7b104d

		changedProperty = Name

	measure 'Loyalty Customers' =
			
			CALCULATE(
			    DISTINCTCOUNT(dim_customer[customer_id]),
			    dim_customer[loyalty_member] = TRUE()
			)
		formatString: 0
		lineageTag: 37a700d6-acde-4fd1-bd4a-2f1dab37bb8e

		changedProperty = Name

	measure 'Loyalty Customer %' =
			
			DIVIDE(
			    [Loyalty Customers],
			    [Total Customers],
			    0
			)
		lineageTag: 82b48a67-dffa-49be-966d-a660c1294964

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

