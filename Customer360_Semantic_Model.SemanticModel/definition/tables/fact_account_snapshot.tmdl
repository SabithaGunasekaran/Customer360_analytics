table fact_account_snapshot
	lineageTag: 981b06ce-92c6-42e2-bcf3-7988a3a96e80
	sourceLineageTag: [dbo].[fact_account_snapshot]

	measure 'Total Balance' =
			
			SUM(
			    fact_account_snapshot[balance]
			)
		lineageTag: 83addd60-b6e1-4abb-b424-0a6f748c9f6d

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Balance' =
			
			AVERAGE(
			    fact_account_snapshot[balance]
			)
		lineageTag: d409e0be-a384-4c2c-ba58-fa37ffa7094c

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Tickets' =
			
			DISTINCTCOUNT(
			    fact_support_ticket[ticket_id]
			)
		formatString: 0
		lineageTag: 21fed11f-43d8-4be9-8baf-295d239a657a

		changedProperty = Name

	measure 'Open Tickets' =
			
			CALCULATE(
			    COUNTROWS(fact_support_ticket),
			    fact_support_ticket[is_open_ticket] = TRUE()
			)
		formatString: 0
		lineageTag: d80c677e-a23f-4800-ad94-63dfeb59ef89

		changedProperty = Name

	measure 'SLA Breaches' =
			
			CALCULATE(
			    COUNTROWS(fact_support_ticket),
			    fact_support_ticket[sla_breached_flag] = TRUE()
			)
		formatString: 0
		lineageTag: 31b5f6e4-0d6b-4932-973c-bee079186217

		changedProperty = Name

	measure 'SLA Compliance %' =
			
			DIVIDE(
			    [Total Tickets] - [SLA Breaches],
			    [Total Tickets],
			    0
			)
		lineageTag: f2a62585-e989-4e41-ab4d-4e3f00cd182c

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Interactions' =
			
			COUNTROWS(
			    fact_marketing_interaction
			)
		formatString: 0
		lineageTag: 4d8cffb0-7610-4249-8f26-efdc8db4292e

		changedProperty = Name

	measure 'Total Responses' =
			
			CALCULATE(
			    COUNTROWS(fact_marketing_interaction),
			    fact_marketing_interaction[responded_flag] = TRUE()
			)
		formatString: 0
		lineageTag: c0a898a3-f5e7-44e9-bd2e-8afbe9ed0515

		changedProperty = Name

	measure 'Response Rate %' =
			
			DIVIDE(
			    [Total Responses],
			    [Total Interactions],
			    0
			)
		lineageTag: 97703ac0-d23e-4705-a616-24d5078d2a5f

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

