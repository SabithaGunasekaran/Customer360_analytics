table dim_customer
	lineageTag: de098d76-f264-438b-9d73-2aad01c91b31
	sourceLineageTag: [dbo].[dim_customer]

	measure 'Total Customers' =
			
			CALCULATE(
			    DISTINCTCOUNT(dim_customer[customer_id]),
			    dim_customer[is_current] = TRUE()
			)
		formatString: 0
		lineageTag: fdcc2d19-c4c3-400b-aa00-a9e0dd608c61

		changedProperty = Name

	measure 'Active Customers' =
			
			CALCULATE(
			    DISTINCTCOUNT(dim_customer[customer_id]),
			    dim_customer[is_current] = TRUE(),
			    dim_customer[is_active_customer] = TRUE()
			)
		formatString: 0
		lineageTag: 2cb77738-bcd8-4300-9ced-a98a40d17903

		changedProperty = Name

